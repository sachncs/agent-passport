# Backend URL that the frontend proxies API requests to.
# Set NEXT_PUBLIC_API_BASE_URL to override on the client side.
# Defaults to http://localhost:3000 (the Express service).
BACKEND_URL=http://localhost:3000

# Override the client-side API base URL. Leave empty to use same-origin
# requests through the Next.js rewrites (recommended).
NEXT_PUBLIC_API_BASE_URL=
