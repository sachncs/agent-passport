---
import "@/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Agent Passport — Trust infrastructure for AI agents",
  description = "Make every agent legible. Agent Passport turns Algorand wallets into explainable trust, risk, and underwriting decisions through one developer-first API.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0A0B0D" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FAFAF7" media="(prefers-color-scheme: light)" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Agent Passport" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Theme bootstrap (avoid flash) -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("ap-theme");
          var prefersLight = window.matchMedia(
            "(prefers-color-scheme: light)",
          ).matches;
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : prefersLight
                ? "light"
                : "dark";
          if (theme === "light") {
            document.documentElement.classList.add("light");
            document.documentElement.classList.remove("dark");
          } else {
            document.documentElement.classList.add("dark");
            document.documentElement.classList.remove("light");
          }
          document.documentElement.style.colorScheme = theme;
        } catch (e) {}
      })();
    </script>

    <!-- JSON-LD -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "Agent Passport",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Web",
        description: description,
        url: "https://sachncs.github.io/agent-passport/",
        author: {
          "@type": "Person",
          name: "Sachin",
        },
        license: "MIT",
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "USD",
          description: "Pay-per-query via x402 USDC",
        },
      })}
    />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-3 focus:py-1.5 focus:text-[oklch(0.18_0.005_250)]"
      >Skip to content</a
    >
    <slot />
  </body>
</html>
