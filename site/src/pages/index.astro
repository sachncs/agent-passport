---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import TrustStrip from "../components/sections/TrustStrip.astro";
import ValueProps from "../components/sections/ValueProps.astro";
import Capabilities from "../components/sections/Capabilities.astro";
import Workflow from "../components/sections/Workflow.astro";
import DeveloperSurface from "../components/sections/DeveloperSurface.astro";
import SecurityProof from "../components/sections/SecurityProof.astro";
import FinalCTA from "../components/sections/FinalCTA.astro";
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <TrustStrip />
    <ValueProps />
    <Capabilities />
    <Workflow />
    <DeveloperSurface />
    <SecurityProof />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
