---
import Container from "./Container.astro";
import Logo from "../brand/Logo.astro";
import Button from "../ui/Button.astro";

const navLinks = [
  { label: "Features", href: "#features" },
  { label: "How it works", href: "#how" },
  { label: "SDKs", href: "#sdks" },
  { label: "Security", href: "#security" },
];

const base = import.meta.env.BASE_URL;
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent transition-colors duration-300"
>
  <Container>
    <div class="flex h-14 items-center justify-between md:h-16">
      <Logo href={base || "/"} size={26} />

      <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-[13px] font-medium tracking-tight text-ink-2 transition-colors hover:text-ink-1"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle theme"
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line bg-surface-1 text-ink-2 transition-all hover:border-line-strong hover:text-ink-1"
        >
          <svg
            id="theme-icon-sun"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hidden"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
            ></path>
          </svg>
          <svg
            id="theme-icon-moon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hidden"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <a
          href="https://github.com/sachncs/agent-passport"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="hidden h-9 w-9 items-center justify-center rounded-full border border-line bg-surface-1 text-ink-2 transition-all hover:border-line-strong hover:text-ink-1 sm:inline-flex"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="currentColor"
          >
            <path
              d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.74-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.18 1.18a11.04 11.04 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.76.12 3.05.74.8 1.18 1.82 1.18 3.08 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.56C20.22 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
            ></path>
          </svg>
        </a>

        <Button
          variant="secondary"
          size="sm"
          href="https://github.com/sachncs/agent-passport/tree/master/frontend"
          external
          class="hidden sm:inline-flex"
        >
          Open Console
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M7 17L17 7M9 7h8v8"></path>
          </svg>
        </Button>
      </div>
    </div>
  </Container>
</header>

<script>
  // Theme toggle logic — applies before paint to avoid flash
  const STORAGE_KEY = "ap-theme";

  function getPreferred() {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored === "light" || stored === "dark") return stored;
    return window.matchMedia("(prefers-color-scheme: light)").matches
      ? "light"
      : "dark";
  }

  function applyTheme(theme: "light" | "dark") {
    const root = document.documentElement;
    if (theme === "light") {
      root.classList.add("light");
      root.classList.remove("dark", "force-dark");
    } else {
      root.classList.remove("light");
      root.classList.add("dark");
    }
    root.style.colorScheme = theme;
    const sun = document.getElementById("theme-icon-sun");
    const moon = document.getElementById("theme-icon-moon");
    if (sun && moon) {
      sun.classList.toggle("hidden", theme !== "light");
      moon.classList.toggle("hidden", theme === "light");
    }
  }

  // Apply immediately (script is at the end of body but we still call this)
  applyTheme(getPreferred() as "light" | "dark");

  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const current = document.documentElement.classList.contains("light")
      ? "light"
      : "dark";
    const next = current === "light" ? "dark" : "light";
    localStorage.setItem(STORAGE_KEY, next);
    applyTheme(next);
  });

  // Sync with system preference if user hasn't chosen
  window
    .matchMedia("(prefers-color-scheme: light)")
    .addEventListener("change", (e) => {
      if (!localStorage.getItem(STORAGE_KEY)) {
        applyTheme(e.matches ? "light" : "dark");
      }
    });

  // Glass effect on header scroll
  const header = document.getElementById("site-header");
  function updateHeader() {
    if (!header) return;
    if (window.scrollY > 8) {
      header.classList.add("glass", "border-line");
    } else {
      header.classList.remove("glass", "border-line");
    }
  }
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  // Mobile menu toggle (placeholder; nav is hidden on mobile for simplicity)
</script>
