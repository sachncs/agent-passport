---
import Container from "./Container.astro";
import Logo from "../brand/Logo.astro";

const columns = [
  {
    heading: "Product",
    links: [
      { label: "Trust Score", href: "https://github.com/sachncs/agent-passport#features" },
      { label: "Underwriting", href: "https://github.com/sachncs/agent-passport#features" },
      { label: "Sybil Detection", href: "https://github.com/sachncs/agent-passport#features" },
      { label: "Passport", href: "https://github.com/sachncs/agent-passport#features" },
    ],
  },
  {
    heading: "Developers",
    links: [
      { label: "Documentation", href: `${import.meta.env.BASE_URL}docs/` },
      { label: "API Reference", href: "https://github.com/sachncs/agent-passport/blob/master/docs/api.md" },
      { label: "Concepts", href: "https://github.com/sachncs/agent-passport/blob/master/docs/concepts.md" },
      { label: "OpenAPI Spec", href: "https://github.com/sachncs/agent-passport/blob/master/docs/api/openapi.yaml" },
    ],
  },
  {
    heading: "Project",
    links: [
      { label: "GitHub", href: "https://github.com/sachncs/agent-passport" },
      { label: "npm", href: "https://www.npmjs.com/package/@agent-passport/api" },
      { label: "Issues", href: "https://github.com/sachncs/agent-passport/issues" },
      { label: "Changelog", href: "https://github.com/sachncs/agent-passport/blob/master/CHANGELOG.md" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <Container class="py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-[1.2fr_2fr] md:gap-16">
      <div>
        <Logo size={26} />
        <p class="mt-5 max-w-xs text-[13px] leading-relaxed text-ink-3">
          Open-source trust and risk infrastructure for AI agents on Algorand.
        </p>
        <div class="mt-6 flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface-1 px-2.5 py-1 text-[11px] font-medium text-ink-2">
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
            Developer preview
          </span>
          <span class="text-[11px] text-ink-3">v0.1.0 preview</span>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-8">
        {
          columns.map((col) => (
            <div>
              <h4 class="text-[11px] font-medium uppercase tracking-[0.16em] text-ink-3">
                {col.heading}
              </h4>
              <ul class="mt-4 space-y-2.5">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.href.startsWith("http") ? "_blank" : undefined}
                      rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                      class="text-[13px] text-ink-2 transition-colors hover:text-ink-1"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-line pt-8 md:flex-row md:items-center"
    >
      <p class="text-[12px] text-ink-3">
        © {year} Agent Passport. MIT License. Built for the Algorand ecosystem.
      </p>
      <div class="flex items-center gap-5 text-[12px] text-ink-3">
        <a
          href="https://github.com/sachncs/agent-passport/security"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-ink-2">Security</a
        >
        <a
          href="https://github.com/sachncs/agent-passport/blob/master/SECURITY.md"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-ink-2">Disclosure</a
        >
        <a
          href="https://github.com/sachncs/agent-passport/blob/master/CODE_OF_CONDUCT.md"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-ink-2">Conduct</a
        >
      </div>
    </div>
  </Container>
</footer>
