---
import Container from "./Container.astro";
import Logo from "../brand/Logo.astro";

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-line"><Container class="py-10"><div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between"><div><Logo size={25} /><p class="mt-3 text-[13px] text-ink-3">Open-source trust infrastructure for autonomous agents.</p></div><nav class="flex flex-wrap gap-x-6 gap-y-3 text-[13px] text-ink-2" aria-label="Footer"><a href={`${import.meta.env.BASE_URL}docs/`} class="hover:text-ink-1">Docs</a><a href="https://github.com/sachncs/agent-passport" target="_blank" rel="noopener noreferrer" class="hover:text-ink-1">GitHub</a><a href="https://github.com/sachncs/agent-passport/blob/master/docs/security.md" target="_blank" rel="noopener noreferrer" class="hover:text-ink-1">Security</a><a href="https://github.com/sachncs/agent-passport/blob/master/docs/api.md" target="_blank" rel="noopener noreferrer" class="hover:text-ink-1">API</a><span class="text-ink-3">Algorand</span></nav></div><div class="mt-8 flex flex-wrap justify-between gap-3 border-t border-line pt-5 text-[11px] text-ink-3"><span>© {year} Agent Passport · MIT License</span><span>v0.1.0 developer preview</span></div></Container></footer>
