---
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className = "" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  role="img"
  aria-label="Agent Passport"
  class={`shrink-0 text-ink-1 ${className}`}
>
  <defs>
    <linearGradient id="ap-mark" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="oklch(0.85 0.16 162)"></stop>
      <stop offset="100%" stop-color="oklch(0.6 0.16 162)"></stop>
    </linearGradient>
  </defs>
  <rect
    x="6"
    y="9"
    width="52"
    height="46"
    rx="9"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    opacity="0.35"></rect>
  <rect
    x="10"
    y="13"
    width="44"
    height="38"
    rx="6.5"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"></rect>
  <circle cx="22" cy="24" r="3.2" fill="url(#ap-mark)"></circle>
  <path
    d="M18 32 L26 32"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    opacity="0.6"></path>
  <path
    d="M18 38 L40 38"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    opacity="0.4"></path>
  <path
    d="M18 44 L34 44"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    opacity="0.4"></path>
  <path
    d="M40 22 C44 24 47 28 46 33 C45 38 41 41 37 41"
    stroke="url(#ap-mark)"
    stroke-width="2.2"
    fill="none"
    stroke-linecap="round"></path>
  <circle cx="38" cy="41" r="1.6" fill="url(#ap-mark)"></circle>
</svg>
