---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const fields = [
  { label: "Issuer", value: "Algorand MainNet" },
  { label: "Subject", value: "GD64…BHU5A" },
  { label: "Issued", value: "2026-09-14" },
  { label: "Algorithm", value: "v2 · composite" },
];

const claims = [
  { k: "trustScore", v: "87 / 100" },
  { k: "riskLevel", v: "low" },
  { k: "delegation.depth", v: "3" },
  { k: "delegation.sponsors", v: "11" },
  { k: "sybil.probability", v: "0.04" },
  { k: "credit.capacity", v: "$12,400" },
];
---

<div class={`relative ${className}`}>
  <div
    class="absolute -inset-px rounded-[20px] bg-gradient-to-br from-accent/20 via-transparent to-[oklch(0.7_0.18_200_/_0.15)] opacity-50 blur-sm"
  >
  </div>

  <div
    class="relative aspect-[3/4] overflow-hidden rounded-[20px] border border-line bg-surface-1 p-6 shadow-card"
  >
    <!-- Top seal -->
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-ink-2"
        >
          <rect x="3" y="4" width="18" height="16" rx="2.5"></rect>
          <line x1="7" y1="9" x2="17" y2="9"></line>
          <line x1="7" y1="13" x2="13" y2="13"></line>
          <circle cx="17" cy="16" r="1.25"></circle>
        </svg>
        <span class="text-[10px] font-medium uppercase tracking-[0.16em] text-ink-3"
          >Agent Passport</span
        >
      </div>
      <div class="font-mono text-[9px] text-ink-3">v0.1.0</div>
    </div>

    <!-- Score seal -->
    <div class="mt-6 flex flex-col items-center">
      <div class="relative">
        <svg viewBox="0 0 120 120" width="110" height="110" class="-rotate-90">
          <circle
            cx="60"
            cy="60"
            r="52"
            fill="none"
            stroke="oklch(0.28 0.008 250)"
            stroke-width="6"></circle>
          <circle
            cx="60"
            cy="60"
            r="52"
            fill="none"
            stroke="oklch(0.78 0.16 162)"
            stroke-width="6"
            stroke-linecap="round"
            stroke-dasharray="326.7"
            stroke-dashoffset="42.5"></circle>
        </svg>
        <div class="absolute inset-0 flex flex-col items-center justify-center">
          <span class="font-serif-italic text-3xl tracking-tight text-ink-1 tabular"
            >87</span
          >
          <span class="text-[9px] uppercase tracking-[0.18em] text-ink-3"
            >trust</span
          >
        </div>
      </div>
    </div>

    <!-- Fields -->
    <div class="mt-6 grid grid-cols-2 gap-4 border-y border-line py-4">
      {
        fields.map((f) => (
          <div>
            <div class="text-[9px] uppercase tracking-[0.18em] text-ink-3">
              {f.label}
            </div>
            <div class="mt-1 font-mono text-[11px] tracking-tight text-ink-1">
              {f.value}
            </div>
          </div>
        ))
      }
    </div>

    <!-- Claims -->
    <div class="mt-4 space-y-1.5">
      {
        claims.map((c) => (
          <div class="flex items-center justify-between text-[11px]">
            <span class="font-mono text-ink-3">{c.k}</span>
            <span class="font-mono tabular text-ink-1">{c.v}</span>
          </div>
        ))
      }
    </div>

    <!-- Footer signature -->
    <div class="mt-5 flex items-center gap-2">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
      <span class="text-[9px] uppercase tracking-[0.18em] text-ink-3"
        >verified on-chain</span
      >
    </div>
  </div>
</div>
