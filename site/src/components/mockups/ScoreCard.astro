---
import Eyebrow from "../ui/Eyebrow.astro";

interface SubScore {
  label: string;
  value: number; // 0-100
}

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

// Composite score sample (drawn from docs/concepts.md: 5 weighted sub-scores)
const composite = 87;
const riskLabel = "Low risk";
const wallet = "GD64YIY3TWGDMCNPP553DZPPR6LDUSFQOIJVFDPPXWEG3FVOJCCDBBHU5A";
const walletShort = `${wallet.slice(0, 6)}…${wallet.slice(-4)}`;

const subScores: SubScore[] = [
  { label: "Age", value: 92 },
  { label: "Activity", value: 78 },
  { label: "Volume", value: 88 },
  { label: "Velocity", value: 81 },
  { label: "Compliance", value: 95 },
];

const explanation = [
  "Wallet age 412 days · strongly established",
  "Median 18.2 txns/month · consistent activity",
  "Balance 12,480 ALGO · diversified holdings",
  "No sanctions or counterparty flags (24h)",
];
---

<div class={`relative ${className}`}>
  <div
    class="absolute -inset-px rounded-[26px] bg-gradient-to-b from-accent/20 via-transparent to-transparent opacity-60 blur-sm"
  >
  </div>

  <div
    class="relative overflow-hidden rounded-[26px] border border-line bg-surface-1 shadow-card"
  >
    <!-- Window chrome -->
    <div
      class="flex items-center justify-between border-b border-line bg-surface-2 px-5 py-3"
    >
      <div class="flex items-center gap-1.5">
        <span class="h-2.5 w-2.5 rounded-full bg-[oklch(0.65_0.18_15)] opacity-50"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[oklch(0.78_0.14_75)] opacity-50"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-accent opacity-60"></span>
      </div>
      <div
        class="font-mono text-[10px] tracking-tight text-ink-3"
      >
        GET /score?wallet={walletShort}
      </div>
      <div class="text-[10px] font-medium tracking-tight text-accent">
        200 OK · 87ms
      </div>
    </div>

    <!-- Score hero -->
    <div class="grid gap-6 px-7 pt-7 sm:grid-cols-[auto_1fr] sm:gap-8">
      <div class="flex flex-col items-start">
        <Eyebrow>Composite Trust</Eyebrow>
        <div class="mt-3 flex items-baseline gap-2">
          <span
            class="font-serif-italic text-[88px] leading-none tracking-tight text-ink-1 tabular"
            style="font-feature-settings: 'ss01', 'tnum'"
          >
            {composite}
          </span>
          <span class="text-xl font-light text-ink-3">/100</span>
        </div>
        <div class="mt-3 flex items-center gap-2">
          <span
            class="inline-flex items-center gap-1.5 rounded-full border border-[oklch(0.78_0.16_162_/_0.3)] bg-[oklch(0.78_0.16_162_/_0.12)] px-2.5 py-0.5 text-[11px] font-medium text-[oklch(0.85_0.16_162)]"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
            {riskLabel}
          </span>
          <span class="text-[11px] text-ink-3">verified on-chain</span>
        </div>
      </div>

      <!-- Sub-score bars -->
      <div class="space-y-3 pt-1">
        {
          subScores.map((s) => (
            <div>
              <div class="mb-1.5 flex items-center justify-between text-[11px] tracking-tight">
                <span class="font-medium text-ink-2">{s.label}</span>
                <span class="font-mono text-ink-3 tabular">{s.value}</span>
              </div>
              <div class="relative h-1.5 overflow-hidden rounded-full bg-surface-3">
                <div
                  class="absolute inset-y-0 left-0 rounded-full bg-gradient-to-r from-[oklch(0.66_0.16_162)] to-accent"
                  style={`width: ${s.value}%;`}
                />
                <div
                  class="absolute inset-y-0 right-0 h-full w-12 translate-x-0 opacity-30 shimmer"
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Explanation block -->
    <div class="mt-7 border-t border-line bg-surface-2/40 px-7 py-5">
      <div class="mb-3 flex items-center justify-between">
        <span
          class="text-[10px] font-medium uppercase tracking-[0.16em] text-ink-3"
          >Why this score</span
        >
        <span class="font-mono text-[10px] text-ink-3">explain()</span>
      </div>
      <ul class="space-y-1.5">
        {
          explanation.map((line) => (
            <li class="flex items-start gap-2.5 text-[12px] text-ink-2">
              <span class="mt-1.5 inline-block h-1 w-1 shrink-0 rounded-full bg-accent" />
              <span>{line}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Floating accent dot -->
  <div
    class="absolute -right-3 -top-3 h-6 w-6 rounded-full bg-accent shadow-glow"
  >
  </div>
</div>
