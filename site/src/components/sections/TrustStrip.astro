---
import Container from "../layout/Container.astro";
const items = ["Verifiable behavior", "Explainable scores", "Deterministic decisions", "Open source"];
---
<section class="border-y border-line bg-surface-1/40 py-5" aria-label="Product proof">
  <Container><div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-[12px] text-ink-2 md:justify-between">{items.map((item) => <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>{item}</span>)}</div></Container>
</section>
