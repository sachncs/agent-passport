---
import Container from "../layout/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";

const layers = [
  { name: "Helmet headers", detail: "CSP, HSTS, frameguard, referrer-policy" },
  { name: "Rate limiting", detail: "600 req/min/IP · sliding window" },
  { name: "HMAC auth", detail: "Signed requests for mutating routes" },
  { name: "Idempotency-Key", detail: "Required on non-GET requests · 24h process-local records" },
  { name: "Body limit", detail: "100 KB request body cap" },
  { name: "30s timeout", detail: "Request-level hard cutoff" },
  { name: "x402 verification", detail: "Optional facilitator-backed payment verification" },
  { name: "Audit logging", detail: "Every request · X-Request-ID traced" },
];
---

<section id="security" class="relative py-24 md:py-32">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[1fr_1.5fr] lg:gap-20">
      
        <Eyebrow icon>Defence in depth</Eyebrow>
        <h2
          class="mt-4 text-balance text-[36px] font-semibold leading-[1.1] tracking-[-0.025em] text-ink-1 md:text-[44px]"
        >
          Built like <span class="font-serif-italic font-normal">infrastructure.</span>
        </h2>
        <p
          class="mt-5 max-w-md text-pretty text-[15px] leading-relaxed text-ink-2"
        >
          Helmet, CORS, bounded bodies and timeouts, request IDs, rate limits,
          conditional HMAC, idempotency, and optional x402 verification. Read
          the threat model for provider and multi-replica boundaries.
        </p>
        <div class="mt-8 flex flex-col gap-2">
          <a
            href="https://github.com/sachncs/agent-passport/blob/master/docs/security.md"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 text-[13px] font-medium text-accent transition-colors hover:text-ink-1"
          >
            Read the threat model
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="13"
              height="13"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform group-hover:translate-x-0.5"
            >
              <path d="M5 12h14M13 5l7 7-7 7"></path>
            </svg>
          </a>
          <a
            href="https://github.com/sachncs/agent-passport/blob/master/SECURITY.md"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 text-[13px] font-medium text-ink-2 transition-colors hover:text-ink-1"
          >
            Disclosure policy
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="13"
              height="13"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform group-hover:translate-x-0.5"
            >
              <path d="M5 12h14M13 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      

      
        <div
          class="overflow-hidden rounded-2xl border border-line bg-surface-1 shadow-card"
        >
          <div
            class="flex items-center justify-between border-b border-line bg-surface-2 px-5 py-3"
          >
            <span class="text-[10px] font-medium uppercase tracking-[0.16em] text-ink-3">
              Hardening layers
            </span>
            <span class="font-mono text-[10px] text-accent">v0.1.0</span>
          </div>
          <ul class="divide-y divide-line">
            {
              layers.map((l, i) => (
                <li class="grid grid-cols-[2.5rem_1fr_1.5fr] items-center gap-4 px-5 py-3.5 text-[13px] transition-colors hover:bg-surface-2">
                  <span class="font-mono text-[10px] text-ink-3 tabular">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="font-medium text-ink-1">{l.name}</span>
                  <span class="text-ink-2">{l.detail}</span>
                </li>
              ))
            }
          </ul>
        </div>
      
    </div>
  </Container>
</section>
