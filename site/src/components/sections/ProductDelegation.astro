---
import Container from "../layout/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import DelegationGraph from "../mockups/DelegationGraph.astro";
---

<section class="relative py-24 md:py-32">
  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-20">
      
        <DelegationGraph />
      

      
        <Eyebrow icon>Delegated trust</Eyebrow>
        <h2
          class="mt-4 text-balance text-[36px] font-semibold leading-[1.1] tracking-[-0.025em] text-ink-1 md:text-[44px]"
        >
          Trust propagates <span class="font-serif-italic font-normal">like light.</span>
        </h2>
        <p
          class="mt-5 max-w-md text-pretty text-[15px] leading-relaxed text-ink-2"
        >
          A bounded BFS walk scores depth, sponsor quality, sponsor count, and
          delegated amount. Registry mutations reject self-delegation; graph
          traversal tracks visited wallets and limits branching.
        </p>

        <div class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line">
          <div class="bg-surface-1 p-4">
            <div class="text-[10px] font-medium uppercase tracking-[0.16em] text-ink-3">
              Max depth
            </div>
            <div class="mt-1 font-serif-italic text-2xl tabular text-ink-1">
              10
            </div>
          </div>
          <div class="bg-surface-1 p-4">
            <div class="text-[10px] font-medium uppercase tracking-[0.16em] text-ink-3">
              Cycle guard
            </div>
            <div class="mt-1 font-serif-italic text-2xl tabular text-accent">
              on
            </div>
          </div>
        </div>
      
    </div>
  </Container>
</section>
