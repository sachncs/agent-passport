---
import Container from "../layout/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import ScoreCard from "../mockups/ScoreCard.astro";
---

<section id="product" class="relative py-24 md:py-32">
  <div
    class="absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-line to-transparent"
  >
  </div>

  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
      
        <Eyebrow icon>The verdict surface</Eyebrow>
        <h2
          class="mt-4 text-balance text-[36px] font-semibold leading-[1.1] tracking-[-0.025em] text-ink-1 md:text-[44px]"
        >
          One number.<br />
          <span class="font-serif-italic font-normal">Five reasons why.</span>
        </h2>
        <p
          class="mt-5 max-w-md text-pretty text-[15px] leading-relaxed text-ink-2"
        >
          Every score ships with an explanation block — the sub-score breakdown,
          a risk pill, and a human-readable reason list. No black boxes. No
          opaque ML you have to take on faith.
        </p>

        <ul class="mt-8 space-y-3 text-[13px] text-ink-2">
          <li class="flex items-center gap-3">
            <span class="inline-block h-1 w-1 rounded-full bg-accent"></span>
            Deterministic algorithm · identical inputs → identical outputs
          </li>
          <li class="flex items-center gap-3">
            <span class="inline-block h-1 w-1 rounded-full bg-accent"></span>
            Verifiable on Algorand · every verdict can be replayed
          </li>
          <li class="flex items-center gap-3">
            <span class="inline-block h-1 w-1 rounded-full bg-accent"></span>
            Sub-100ms cached · 250ms cold from the chain
          </li>
        </ul>
      

      
        <div
          class="absolute -inset-8 -z-10 rounded-[40px] bg-gradient-to-br from-accent/8 via-transparent to-[oklch(0.7_0.18_200_/_0.05)] blur-2xl"
        >
        </div>
        <ScoreCard />
      
    </div>
  </Container>
</section>
