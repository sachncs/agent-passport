---
import Container from "../layout/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";

const request = `WALLET=GD64YIY3... # replace with a 58-character Algorand address
curl "http://localhost:3000/score?wallet=$WALLET" \\
  -H "Accept: application/json"`;

const response = `{
  "wallet": "GD64…BHU5A",
  "trustScore": 78,
  "riskLevel": "low",
  "breakdown": {
    "ageScore": 82,
    "activityScore": 74,
    "volumeScore": 69,
    "velocityScore": 86,
    "complianceScore": 91
  },
  "onChain": {
    "balanceAlgo": 512.34,
    "totalTxns": 287,
    "assetCount": 4,
    "accountAgeDays": 412
  },
  "explanation": [
    "412-day wallet history",
    "287 transactions — active history",
    "Illustrative response; provider data varies"
  ]
}`;
---

<section class="relative py-24 md:py-32">
  <Container>
    
      <Eyebrow icon>Wire format</Eyebrow>
      <h2
        class="mt-4 text-balance text-[36px] font-semibold leading-[1.1] tracking-[-0.025em] text-ink-1 md:text-[44px]"
      >
        Plain HTTP. <span class="font-serif-italic font-normal">Predictable JSON.</span>
      </h2>
      <p class="mt-5 max-w-xl text-pretty text-base leading-relaxed text-ink-2 md:text-lg">
        Every endpoint follows the same conventions — query params in,
        JSON out, an <code class="font-mono text-[13px] text-accent">X-Request-ID</code> on every response, and an optional 402 payment required body when
        x402 metering is enabled.
      </p>
    

    
      <div
        class="overflow-hidden rounded-2xl border border-line bg-surface-1 shadow-card"
      >
        <div
          class="flex items-center justify-between border-b border-line bg-surface-2 px-4 py-3"
        >
          <div class="flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.16em] text-ink-3">
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
            Illustrative example · GET /score
          </div>
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-[oklch(0.65_0.18_15)] opacity-50"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[oklch(0.78_0.14_75)] opacity-50"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-accent opacity-60"></span>
          </div>
        </div>

        <div class="grid md:grid-cols-2">
          <div class="border-b border-line p-6 md:border-b-0 md:border-r">
            <div class="mb-4 flex items-center gap-2">
              <span
                class="rounded-md border border-line bg-surface-2 px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] text-accent"
              >
                Request
              </span>
              <span class="font-mono text-[10px] text-ink-3">curl</span>
            </div>
            <pre
              class="overflow-x-auto font-mono text-[12px] leading-relaxed text-ink-1"
            ><code>{request}</code></pre>
          </div>

          <div class="p-6">
            <div class="mb-4 flex items-center gap-2">
              <span
                class="rounded-md border border-line bg-surface-2 px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] text-accent"
              >
                Response · 200 OK
              </span>
              <span class="font-mono text-[10px] text-ink-3">demo data</span>
            </div>
            <pre
              class="overflow-x-auto font-mono text-[12px] leading-relaxed text-ink-1"
            ><code>{response}</code></pre>
          </div>
        </div>
      </div>
    
  </Container>
</section>
