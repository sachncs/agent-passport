---
import Container from "../layout/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";

const metrics = [
  { value: "<100", unit: "ms", label: "p50 cached latency" },
  { value: "5", unit: "", label: "sub-scores per verdict" },
  { value: "12", unit: "", label: "sybil signals" },
  { value: "60", unit: "s", label: "edge cache TTL" },
  { value: "600", unit: "/min", label: "rate limit per IP" },
  { value: "$100k", unit: "", label: "system exposure cap" },
];
---

<section class="relative py-24 md:py-32">
  <Container>
    
      <Eyebrow icon>Production posture</Eyebrow>
      <h2
        class="mt-4 text-balance text-[36px] font-semibold leading-[1.1] tracking-[-0.025em] text-ink-1 md:text-[44px]"
      >
        SLO-instrumented. <span class="font-serif-italic font-normal">Alerted. Runbooked.</span>
      </h2>
      <p class="mt-5 max-w-xl text-pretty text-base leading-relaxed text-ink-2 md:text-lg">
        Prometheus metrics on every route, two SLO profiles (strict + relaxed),
        19 alert rules with runbooks, and a 17-panel Grafana dashboard.
      </p>
    

    
      <div
        class="overflow-hidden rounded-2xl border border-line bg-surface-1 shadow-card"
      >
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
          {
            metrics.map((m, i) => (
              <div
                class={`p-6 md:p-7 ${
                  i < metrics.length - 1
                    ? "border-b border-line sm:border-b-0 sm:border-r"
                    : ""
                } ${
                  (i + 1) % 3 === 0
                    ? "sm:border-r-0 lg:border-r"
                    : ""
                }`}
              >
                <div class="flex items-baseline gap-1">
                  <span class="font-serif-italic text-[44px] leading-none tracking-tight text-ink-1 tabular">
                    {m.value}
                  </span>
                  <span class="text-sm font-light text-ink-3">{m.unit}</span>
                </div>
                <div class="mt-3 text-[11px] font-medium uppercase tracking-[0.16em] text-ink-3">
                  {m.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    
  </Container>
</section>
