---
import Container from "../layout/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
const steps = [["01", "Provide identity", "A wallet or agent identifier."], ["02", "Analyze signals", "History, relationships, and behavior."], ["03", "Evaluate risk", "Deterministic factors and thresholds."], ["04", "Return a verdict", "JSON your application can inspect."]];
---
<section class="border-y border-line bg-surface-1/35 py-24 md:py-28"><Container><div class="flex flex-col justify-between gap-8 md:flex-row md:items-end"><div><Eyebrow icon>How it works</Eyebrow><h2 class="mt-4 text-[38px] font-semibold leading-none tracking-[-0.04em] text-ink-1 md:text-[52px]">One identity.<br /><span class="font-serif-italic font-normal">Four clear steps.</span></h2></div><p class="max-w-xs text-[14px] leading-relaxed text-ink-2">No opaque classification. The output carries the evidence your system needs to act.</p></div><div class="mt-14 grid gap-0 md:grid-cols-4">{steps.map(([n, title, body]) => <div class="relative border-t border-line px-0 py-6 md:border-l md:border-t-0 md:px-6 md:first:border-l-0 md:first:pl-0"><div class="font-mono text-[11px] text-accent">{n}</div><h3 class="mt-10 text-lg font-semibold text-ink-1">{title}</h3><p class="mt-2 max-w-[14rem] text-[13px] leading-relaxed text-ink-2">{body}</p></div>)}</div></Container></section>
