---
import Container from "../layout/Container.astro";
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import ScoreCard from "../mockups/ScoreCard.astro";
---

<section class="relative overflow-hidden bg-stage">
  <div class="bg-grain absolute inset-0"></div>
  <div class="bg-grid absolute inset-0 opacity-50"></div>

  <Container class="relative pb-16 pt-20 md:pb-24 md:pt-32">
    <div class="grid items-center gap-16 lg:grid-cols-[1.05fr_1fr] lg:gap-20">
      
        <Eyebrow icon>Trust infrastructure · Algorand</Eyebrow>

        <h1
          class="mt-5 text-balance text-[44px] font-semibold leading-[1.05] tracking-[-0.03em] text-ink-1 sm:text-[56px] md:text-[64px] lg:text-[72px]"
        >
          Know exactly who<br />
          you're <span class="font-serif-italic font-normal text-accent"
            >dealing with.</span
          >
        </h1>

        <p
          class="mt-6 max-w-xl text-pretty text-base leading-relaxed text-ink-2 md:text-lg"
        >
          A stateless, pay-per-query API that scores, flags, and underwrites
          any Algorand wallet in under 100&nbsp;ms. One endpoint. One verdict.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button
            href="https://github.com/sachncs/agent-passport/blob/master/docs/README.md"
            external
            size="lg"
            variant="primary"
          >
            Read the docs
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14M13 5l7 7-7 7"></path>
            </svg>
          </Button>
          <Button
            href="https://github.com/sachncs/agent-passport"
            external
            size="lg"
            variant="secondary"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="currentColor"
            >
              <path
                d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.74-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.18 1.18a11.04 11.04 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.76.12 3.05.74.8 1.18 1.82 1.18 3.08 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.56C20.22 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
              ></path>
            </svg>
            Star on GitHub
          </Button>
        </div>

        <div class="mt-10 flex items-center gap-6">
          <div class="flex -space-x-2">
            <span
              class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-canvas bg-gradient-to-br from-[oklch(0.78_0.16_162)] to-[oklch(0.66_0.16_162)] text-[10px] font-semibold text-[oklch(0.18_0.005_250)]"
              >A</span
            >
            <span
              class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-canvas bg-gradient-to-br from-[oklch(0.78_0.14_75)] to-[oklch(0.66_0.14_75)] text-[10px] font-semibold text-[oklch(0.18_0.005_250)]"
              >B</span
            >
            <span
              class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-canvas bg-gradient-to-br from-[oklch(0.7_0.18_30)] to-[oklch(0.62_0.18_30)] text-[10px] font-semibold text-[oklch(0.18_0.005_250)]"
              >C</span
            >
            <span
              class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-canvas bg-surface-2 text-[10px] font-semibold text-ink-2"
              >+</span
            >
          </div>
          <div class="text-[12px] text-ink-3">
            Trusted by 12+ agent operators on Algorand testnet
          </div>
        </div>
      

      
        <div class="float-loop relative mx-auto w-full max-w-[560px]">
          <ScoreCard />

          <!-- Behind-stack decorative card -->
          <div
            class="absolute -bottom-6 -right-6 -z-10 hidden h-full w-full rounded-[26px] border border-line bg-surface-2/60 blur-md md:block"
          >
          </div>
        </div>
      
    </div>
  </Container>
</section>
