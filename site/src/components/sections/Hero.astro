---
import Container from "../layout/Container.astro";
import Button from "../ui/Button.astro";

const wallet = "GD64YIY3…BHU5A";
const factors = [
  ["Longevity", "82", "Established history"],
  ["Activity", "74", "Consistent use"],
  ["Velocity", "86", "No burst pattern"],
  ["Network", "69", "Limited delegation"],
];
---

<section class="hero relative overflow-hidden bg-stage">
  <div class="bg-grid absolute inset-0 opacity-50"></div>
  <Container class="relative pb-20 pt-16 md:pb-28 md:pt-24 lg:pt-28">
    <div class="grid items-center gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <div class="relative z-10 max-w-xl">
        <div class="inline-flex items-center gap-2 text-[12px] font-medium text-ink-2"><span class="h-2 w-2 rounded-full bg-accent"></span>Trust infrastructure for autonomous agents</div>
        <h1 class="mt-7 text-balance text-[52px] font-semibold leading-[0.94] tracking-[-0.06em] text-ink-1 sm:text-[68px] lg:text-[82px]">Know which<br /><span class="font-serif-italic font-normal text-accent">agents to trust.</span></h1>
        <p class="mt-7 max-w-lg text-pretty text-[17px] leading-[1.55] text-ink-2 md:text-[19px]">Turn verifiable behavior into explainable trust scores and risk signals your systems can use.</p>
        <div class="mt-9 flex flex-wrap items-center gap-3"><Button href="#check-agent" size="lg" variant="primary">Check an agent <span aria-hidden="true">→</span></Button><Button href={`${import.meta.env.BASE_URL}docs/`} size="lg" variant="secondary">Read the docs <span aria-hidden="true">↗</span></Button></div>
        <div class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-[12px] text-ink-3"><span>Open source</span><span>Explainable</span><span>Deterministic</span><span>Evidence-led</span></div>
      </div>

      <div id="check-agent" class="relative mx-auto w-full max-w-[600px] scroll-mt-28"><div class="absolute -inset-8 rounded-full bg-accent/[0.07] blur-3xl"></div><div class="relative overflow-hidden rounded-[28px] border border-line bg-surface-1 shadow-card">
        <div class="flex items-center justify-between border-b border-line px-5 py-4"><div><div class="text-[11px] font-semibold text-ink-1">Agent trust profile</div><div class="mt-1 font-mono text-[10px] text-ink-3">Illustrative response · demo data</div></div><span class="rounded-full border border-accent/25 bg-accent/10 px-2.5 py-1 text-[10px] font-medium text-accent">GET /score</span></div>
        <div class="grid gap-8 p-6 sm:grid-cols-[0.85fr_1.15fr] sm:p-8"><div><div class="text-[11px] text-ink-3">Agent identity</div><div class="mt-2 font-mono text-[12px] text-ink-1">{wallet}</div><div class="mt-7 flex items-end gap-2"><span class="font-serif-italic text-[76px] leading-none text-ink-1">78</span><span class="pb-2 text-sm text-ink-3">/ 100</span></div><div class="mt-3 inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/10 px-3 py-1.5 text-[12px] font-medium text-accent"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>Low risk</div><div class="mt-5 font-mono text-[10px] text-ink-3">confidence <span class="text-ink-1">0.84</span></div></div><div><div class="flex items-center justify-between"><span class="text-[11px] font-medium text-ink-2">Why this score?</span><span class="font-mono text-[10px] text-ink-3">5 inputs</span></div><div class="mt-4 space-y-4">{factors.map(([label, value, reason]) => <div><div class="flex items-center justify-between text-[11px]"><span class="text-ink-2">{label}</span><span class="font-mono text-ink-3">{value}</span></div><div class="mt-1.5 h-1.5 rounded-full bg-surface-3"><div class="h-full rounded-full bg-accent" style={`width:${value}%;`}></div></div><div class="mt-1 text-[10px] text-ink-3">{reason}</div></div>)}</div></div></div>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line bg-surface-2/40 px-6 py-4 text-[10px] text-ink-3 sm:px-8"><span class="font-mono">riskLevel: low</span><span class="font-mono">checksum: sha256…</span><span class="text-accent">Inspectable output</span></div>
      </div></div>
    </div>
  </Container>
</section>
