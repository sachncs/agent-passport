---
import Container from "../layout/Container.astro";
import Button from "../ui/Button.astro";
import ScoreCard from "../mockups/ScoreCard.astro";
---

<section class="hero relative overflow-hidden bg-stage">
  <div class="bg-grain absolute inset-0"></div>
  <div class="bg-grid absolute inset-0 opacity-60"></div>
  <div class="hero-orbit absolute left-1/2 top-[-20rem] h-[48rem] w-[48rem] -translate-x-1/2 rounded-full border border-accent/10"></div>
  <div class="hero-orbit hero-orbit--inner absolute left-1/2 top-[-10rem] h-[28rem] w-[28rem] -translate-x-1/2 rounded-full border border-accent/10"></div>

  <Container class="relative pb-20 pt-16 md:pb-28 md:pt-24 lg:pt-28">
    <div class="grid items-center gap-14 lg:grid-cols-[0.92fr_1.08fr] lg:gap-20">
      <div class="relative z-10">
        <div class="inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/[0.08] px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.16em] text-accent">
          <span class="relative flex h-1.5 w-1.5"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span><span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent"></span></span>
          Trust infrastructure for AI agents
        </div>

        <h1 class="mt-7 max-w-[720px] text-balance text-[48px] font-semibold leading-[0.96] tracking-[-0.055em] text-ink-1 sm:text-[66px] md:text-[78px] lg:text-[86px]">
          Make every<br />
          <span class="font-serif-italic font-normal text-accent">agent legible.</span>
        </h1>

        <p class="mt-7 max-w-xl text-pretty text-[17px] leading-[1.6] text-ink-2 md:text-[19px]">
          Agent Passport turns an Algorand wallet into an explainable trust decision—so marketplaces, lenders, and autonomous systems can transact with confidence.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <Button href="https://github.com/sachncs/agent-passport/blob/master/docs/api.md" external size="lg" variant="primary">
            Start with the API
            <span aria-hidden="true">→</span>
          </Button>
          <Button href="#product" size="lg" variant="secondary">
            See the verdict
            <span aria-hidden="true">↓</span>
          </Button>
        </div>

        <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3 text-[11px] text-ink-3">
          <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>Open source · MIT</span>
          <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>On-chain verifiable</span>
          <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>x402 ready</span>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-[610px] lg:pt-8">
        <div class="absolute -inset-10 rounded-full bg-accent/[0.07] blur-3xl"></div>
        <div class="relative rounded-[30px] border border-line bg-surface-1/70 p-2 shadow-card backdrop-blur-sm">
          <div class="flex items-center justify-between border-b border-line px-4 py-3">
            <div class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-accent"></span><span class="font-mono text-[10px] uppercase tracking-[0.16em] text-ink-3">Live decision surface</span></div>
            <span class="font-mono text-[10px] text-accent">POST /score</span>
          </div>
          <div class="p-2 pt-4 sm:p-4 sm:pt-5"><ScoreCard /></div>
          <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line px-4 py-3 text-[10px] text-ink-3 sm:px-5">
            <span class="font-mono">REQUEST_ID 8c3d…b41</span>
            <span class="inline-flex items-center gap-1.5 text-accent"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>VERIFIED ON-CHAIN</span>
          </div>
        </div>
        <div class="absolute -bottom-5 -left-5 hidden rounded-xl border border-line bg-surface-2/90 px-4 py-3 shadow-card backdrop-blur sm:block">
          <div class="font-mono text-[9px] uppercase tracking-[0.14em] text-ink-3">Decision latency</div>
          <div class="mt-1 font-serif-italic text-2xl text-ink-1">87<span class="ml-1 text-xs font-sans not-italic text-ink-3">ms</span></div>
        </div>
        <div class="absolute -right-5 top-4 hidden rounded-xl border border-accent/20 bg-surface-1/90 px-4 py-3 shadow-card backdrop-blur sm:block">
          <div class="font-mono text-[9px] uppercase tracking-[0.14em] text-ink-3">Risk verdict</div>
          <div class="mt-1 flex items-center gap-2 text-sm font-medium text-accent"><span class="h-2 w-2 rounded-full bg-accent"></span>Low risk</div>
        </div>
      </div>
    </div>
  </Container>

  <div class="relative border-t border-line bg-surface-1/30">
    <Container class="grid grid-cols-2 divide-x divide-line sm:grid-cols-4">
      <div class="px-4 py-5 sm:px-6"><div class="font-serif-italic text-2xl text-ink-1">0–100</div><div class="mt-1 text-[10px] uppercase tracking-[0.14em] text-ink-3">Explainable score</div></div>
      <div class="px-4 py-5 sm:px-6"><div class="font-serif-italic text-2xl text-ink-1">&lt;100<span class="font-sans text-sm text-ink-3">ms</span></div><div class="mt-1 text-[10px] uppercase tracking-[0.14em] text-ink-3">Cached response</div></div>
      <div class="px-4 py-5 sm:px-6"><div class="font-serif-italic text-2xl text-ink-1">09</div><div class="mt-1 text-[10px] uppercase tracking-[0.14em] text-ink-3">Product endpoints</div></div>
      <div class="px-4 py-5 sm:px-6"><div class="font-serif-italic text-2xl text-ink-1">∞</div><div class="mt-1 text-[10px] uppercase tracking-[0.14em] text-ink-3">Replayable decisions</div></div>
    </Container>
  </div>
</section>
