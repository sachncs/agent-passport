---
import Container from "../layout/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
const capabilities = [
  { n: "01", name: "Score", title: "See the signal behind the number.", body: "Turn activity, age, volume, velocity, and balance into a 0–100 score with reasons attached.", visual: "score" },
  { n: "02", name: "Verify", title: "Understand the network around an agent.", body: "Inspect delegation, reputation, relationships, and Sybil-like indicators before you act.", visual: "graph" },
  { n: "03", name: "Underwrite", title: "Make a decision your system can defend.", body: "Combine trust signals into deterministic risk decisions, capacity estimates, and limits.", visual: "decision" },
];
---
<section class="py-20 md:py-28">
  <Container>
    <div class="max-w-2xl"><Eyebrow icon>Decision surfaces</Eyebrow><h2 class="mt-4 text-balance text-[38px] font-semibold leading-[1.04] tracking-[-0.04em] text-ink-1 md:text-[54px]">Trust is a product primitive.</h2><p class="mt-5 max-w-xl text-[16px] leading-relaxed text-ink-2">One evidence layer for ranking, verification, and decisions your operations team can defend.</p></div>
    <div class="mt-14 grid gap-4 lg:grid-cols-3">
      {capabilities.map((cap) => <article data-capability={cap.visual} class="capability-card group relative overflow-hidden rounded-[24px] border border-line bg-surface-1 p-6 md:p-7"><div class="flex items-center justify-between"><span class="font-mono text-[11px] text-accent">{cap.n}</span><span class="text-[11px] text-ink-2">{cap.name}</span></div><h3 class="mt-16 text-[25px] font-semibold leading-tight tracking-[-0.03em] text-ink-1">{cap.title}</h3><p class="mt-3 max-w-sm text-[14px] leading-relaxed text-ink-2">{cap.body}</p><div class="mt-10 min-h-32 border-t border-line pt-5">{cap.visual === "score" && <div class="flex items-center gap-4"><span class="font-serif-italic text-5xl text-ink-1">78</span><div class="flex-1"><div class="h-2 rounded-full bg-surface-3"><div class="h-full w-[78%] rounded-full bg-accent"></div></div><div class="mt-2 font-mono text-[10px] text-ink-2">trustScore / 100</div></div></div>}{cap.visual === "graph" && <div class="capability-graph-flow" aria-label="Relationship to evidence flow"><div class="capability-graph-stage"><span class="capability-graph-icon">A</span><div><strong>Agent</strong><span>subject</span></div></div><div class="capability-graph-arrow" aria-hidden="true">→</div><div class="capability-graph-stage capability-graph-stage--active"><span class="capability-graph-icon">N</span><div><strong>Network</strong><span>depth + ties</span></div></div><div class="capability-graph-arrow" aria-hidden="true">→</div><div class="capability-graph-stage"><span class="capability-graph-icon">E</span><div><strong>Evidence</strong><span>signals</span></div></div></div>}{cap.visual === "decision" && <div class="flex items-center justify-between"><div><div class="font-mono text-[10px] text-ink-2">riskLevel</div><div class="mt-2 text-xl font-semibold text-ink-1">low</div></div><div class="text-4xl text-accent">→</div><div class="text-right"><div class="font-mono text-[10px] text-ink-2">action</div><div class="mt-2 text-xl font-semibold text-ink-1">approve</div></div></div>}</div></article>)}
    </div>
  </Container>
</section>
