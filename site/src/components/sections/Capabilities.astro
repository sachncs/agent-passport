---
import Container from "../layout/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
const capabilities = [
  { n: "01", name: "Score", title: "See the signal behind the number.", body: "Turn activity, age, volume, velocity, and balance into a 0–100 score with reasons attached.", visual: "score" },
  { n: "02", name: "Verify", title: "Understand the network around an agent.", body: "Inspect delegation, reputation, relationships, and Sybil-like indicators before you act.", visual: "graph" },
  { n: "03", name: "Underwrite", title: "Make a decision your system can defend.", body: "Combine trust signals into deterministic risk decisions, capacity estimates, and limits.", visual: "decision" },
];
---
<section class="py-24 md:py-32">
  <Container>
    <div class="max-w-2xl"><Eyebrow icon>Three ways to use it</Eyebrow><h2 class="mt-4 text-balance text-[38px] font-semibold leading-[1.04] tracking-[-0.04em] text-ink-1 md:text-[54px]">Trust is a product primitive.</h2><p class="mt-5 max-w-xl text-[16px] leading-relaxed text-ink-2">Use the same evidence layer to rank, verify, and approve autonomous interactions.</p></div>
    <div class="mt-14 grid gap-4 lg:grid-cols-3">
      {capabilities.map((cap) => <article class="group relative overflow-hidden rounded-[24px] border border-line bg-surface-1 p-6 md:p-7"><div class="flex items-center justify-between"><span class="font-mono text-[11px] text-accent">{cap.n}</span><span class="text-[11px] text-ink-3">{cap.name}</span></div><h3 class="mt-16 text-[25px] font-semibold leading-tight tracking-[-0.03em] text-ink-1">{cap.title}</h3><p class="mt-3 max-w-sm text-[14px] leading-relaxed text-ink-2">{cap.body}</p><div class="mt-10 h-32 border-t border-line pt-5">{cap.visual === "score" && <div class="flex items-center gap-4"><span class="font-serif-italic text-5xl text-ink-1">78</span><div class="flex-1"><div class="h-2 rounded-full bg-surface-3"><div class="h-full w-[78%] rounded-full bg-accent"></div></div><div class="mt-2 font-mono text-[10px] text-ink-3">trustScore / 100</div></div></div>}{cap.visual === "graph" && <div class="relative h-full"><div class="absolute left-[8%] top-1/2 h-px w-[84%] bg-accent/50"></div><div class="absolute left-[10%] top-[36%] h-7 w-7 rounded-full border border-accent bg-accent/15"></div><div class="absolute left-[45%] top-[36%] h-7 w-7 rounded-full border border-accent/70 bg-accent/10"></div><div class="absolute right-[10%] top-[36%] h-7 w-7 rounded-full border border-line-strong bg-surface-2"></div><div class="absolute inset-x-0 bottom-0 text-center font-mono text-[10px] text-ink-3">relationship → depth → evidence</div></div>}{cap.visual === "decision" && <div class="flex items-center justify-between"><div><div class="font-mono text-[10px] text-ink-3">riskLevel</div><div class="mt-2 text-xl font-semibold text-ink-1">low</div></div><div class="text-4xl text-accent">→</div><div class="text-right"><div class="font-mono text-[10px] text-ink-3">action</div><div class="mt-2 text-xl font-semibold text-ink-1">approve</div></div></div>}</div></article>)}
    </div>
  </Container>
</section>
