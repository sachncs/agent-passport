---
import Container from "../layout/Container.astro";
import Button from "../ui/Button.astro";
const docsHref = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/docs/`;
---
<section class="py-24 md:py-32"><Container><div class="relative overflow-hidden rounded-[28px] border border-line bg-surface-1 px-6 py-16 text-center shadow-card md:px-12 md:py-24"><div class="absolute left-1/2 top-0 h-48 w-96 -translate-x-1/2 rounded-full bg-accent/[0.08] blur-3xl"></div><div class="relative"><div class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">Agent Passport</div><h2 class="mx-auto mt-5 max-w-2xl text-balance text-[42px] font-semibold leading-[0.98] tracking-[-0.05em] text-ink-1 md:text-[64px]">Know who you’re dealing with.</h2><p class="mx-auto mt-5 max-w-md text-[16px] leading-relaxed text-ink-2">Evaluate an agent before your system trusts it.</p><div class="mt-8 flex flex-wrap justify-center gap-3"><Button href="#check-agent" size="lg" variant="primary">Check an agent <span aria-hidden="true">→</span></Button><Button href={docsHref} size="lg" variant="secondary">Read the docs <span aria-hidden="true">↗</span></Button></div></div></div></Container></section>
